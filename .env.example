# Optional MongoDB Atlas archive. Never commit your actual .env or URI.
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=godavari

# Optional dense-crowd estimators (PET / DM-Count). Place checkpoints in
# models/, then enable one or both backends. They remain advisory until
# camera validation. Values: dense
CROWD_POINT_BACKEND=
CROWD_POINT_MODEL_VALIDATED=0
CROWD_DENSITY_BACKEND=
CROWD_DENSITY_VALIDATED=0
# Estimator cadence per camera, and the PET regression correction (keep off until
# validated on your own footage).
CROWD_POINT_PERIOD_S=5
CROWD_DENSITY_PERIOD_S=6
CROWD_PET_CORRECTION=0
CROWD_VALIDATION_MIN_SAMPLES=20
CROWD_VALIDATION_MAX_MAPE=0.20
CROWD_VALIDATION_TTL_DAYS=30

# Optional API auth (both empty = open API, for loopback-only deployments).
# Send as `X-API-Key: <token>` or `Authorization: Bearer <token>`.
CROWD_AUTH_OPERATOR_TOKEN=
CROWD_AUTH_VIEWER_TOKEN=

# Edge -> district push (leave the URL empty for a standalone node).
CROWD_DISTRICT_NODE_ID=
CROWD_DISTRICT_PUSH_URL=
CROWD_DISTRICT_SECRET=
CROWD_DISTRICT_PUSH_PERIOD_S=15
CROWD_DISTRICT_NODE_TTL_S=60
